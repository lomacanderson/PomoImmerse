<UserControl x:Class="PomoImmerse.SettingsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PomoImmerse"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
            <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Settings" HorizontalAlignment="Center" FontSize="30" Margin="20"/>
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" Margin="5" FontSize="15" Text="Main Interval:"/>
                <TextBox Name="MainIntervalBox" Grid.Row="0" Grid.Column="1" Margin="5" Width="100" LostFocus="MainIntervalBox_OnLostFocus"/>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Break Interval:" Margin="5" FontSize="15"/>
                <TextBox Name="BreakIntervalBox" Grid.Row="1" Grid.Column="1" Margin="5" Width="100" LostFocus="BreakIntervalBox_OnLostFocus"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Background Image Query:" Margin="5" FontSize="15" Visibility="Collapsed"/>
                <TextBox Name="ImageQueryBox" Grid.Row="1" Grid.Column="1" Margin="5" LostFocus="ImageQueryBox_OnLostFocus" Visibility="Collapsed"/>
            </Grid>
            <TextBlock Text="Image search requires image microservice" HorizontalAlignment="Center" FontSize="10" Foreground="Gray" Margin="5" Visibility="Collapsed"/>
        </StackPanel>
        <Button Name="ExitBtn" Content="X" FontSize="20" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{x:Null}" Background="{x:Null}" FontFamily="Gill Sans MT" Click="ExitBtn_OnClick"/>
    </Grid>
</UserControl>
